import json
import network
import time
import asyncio
from machine import Pin, SPI
import max7219
from umqtt.simple import MQTTClient

CONFIG_FILE = "config.json"
HTML_FILE = "index.html"

# BEISPIEL für die neue Topics-Struktur bei JSON:
# "gaslevel/temperature:weight_1" extrahiert 0.81
# "gaslevel/temperature:temperature" extrahiert 21.8
default_config = {
    "ssid": "Wlan.Ssid",
    "password": "yourWlanPwd",
    "mqtt_server": "192.168.178.1",
    "mqtt_port": 1883,
    "topics": "esp32s3/frischwasser, gaslevel/temperature:weight_1, gaslevel/temperature:temperature, N/b827eb1dc435/battery/1/Soc",
    "prefixes": "Wasser:,Gewicht:,Temp:,SOC:",
    "units": "%,kg,*,%",
    "brightness": 2,
    "speed": 25
}

config = default_config
mqtt_data = {}
client = None
laufschrift_text = "Starte..."
mqtt_connected = False

def load_config():
    global config
    try:
        with open(CONFIG_FILE, "r") as f:
            config = json.load(f)
        print("Konfiguration erfolgreich geladen.")
    except Exception as e:
        print("Fehler beim Laden:", e)
        save_config(default_config)
        config = default_config

def save_config(cfg):
    try:
        with open(CONFIG_FILE, "w") as f:
            json.dump(cfg, f)
            f.flush()
        print("Konfiguration erfolgreich gespeichert.")
    except Exception as e:
        print("Fehler beim Speichern der config.json:", e)

load_config()

spi = SPI(1, baudrate=10000000, polarity=0, phase=0, sck=Pin(12), mosi=Pin(11))
cs = Pin(10, Pin.OUT)
display = max7219.Matrix8x8(spi, cs, 8)
display.brightness(int(config.get("brightness", 2)))

def clean_text(text):
    if not text: return ""
    replacements = {
        "°": "*", "ä": "ae", "ö": "oe", "ü": "ue",
        "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss", "€": "Eur"
    }
    cleaned = str(text)
    for char, replacement in replacements.items():
        cleaned = cleaned.replace(char, replacement)
    return cleaned

def extract_json_value(payload_str, target_key):
    """Extrahiert einen spezifischen Key aus dem JSON-String."""
    try:
        data = json.loads(payload_str)
        if isinstance(data, dict) and target_key in data:
            return str(data[target_key])
    except Exception as e:
        print("JSON Parse Fehler:", e)
    return payload_str

def mqtt_callback(topic, msg):
    global mqtt_data
    topic_str = topic.decode('utf-8')
    msg_str = msg.decode('utf-8').strip()
    
    # Durchsuche die konfigurierten Topics (inklusive möglicher JSON-Keys mit Doppelpunkt)
    configured_topics = [t.strip() for t in config.get("topics", "").split(",")]
    
    for cfg_topic in configured_topics:
        # Prüfen, ob das aktuelle MQTT-Topic zu einem Eintrag passt
        # Unterstützt reines Topic "mein/topic" ODER mit Key "mein/topic:key_name"
        base_topic = cfg_topic.split(":")[0]
        
        if topic_str == base_topic:
            value_str = msg_str
            
            # Wenn ein Doppelpunkt existiert, extrahiere den spezifischen JSON-Inhalt
            if ":" in cfg_topic:
                target_key = cfg_topic.split(":")[1]
                value_str = extract_json_value(msg_str, target_key)
            
            # Speichere die Daten exakt unter dem in der Config definierten Namen ab
            mqtt_data[cfg_topic] = value_str
            print("MQTT Update - Config-Eintrag: {}, extrahierter Wert: {}".format(cfg_topic, value_str))

    update_laufschrift_text()

def update_laufschrift_text():
    global laufschrift_text
    topics = [t.strip() for t in config.get("topics", "").split(",")]
    prefixes = [p.strip() for p in config.get("prefixes", "").split(",")]
    units = [u.strip() for u in config.get("units", "").split(",")]
    
    parts = []
    for i, topic in enumerate(topics):
        if topic in mqtt_data:
            val = mqtt_data[topic]
            prefix = prefixes[i] if i < len(prefixes) else ""
            unit = units[i] if i < len(units) else ""
            parts.append("{}{} {}".format(prefix, val, unit))
            
    if parts:
        laufschrift_text = "  +  ".join(parts) + "  "
    else:
        laufschrift_text = "Warte auf MQTT Daten... "

async def scroll_text():
    global laufschrift_text
    while True:
        text_to_show = clean_text(laufschrift_text)
        text_len = len(text_to_show) * 8 
        
        for x in range(32, -text_len, -1):
            display.fill(0)
            display.text(text_to_show, x, 0, 1)
            display.show()
            await asyncio.sleep_ms(int(config.get("speed", 25)))

async def mqtt_loop():
    global client, mqtt_connected
    
    # Bereite die echten MQTT-Topics für das Abonnement vor (entferne den :key Suffix)
    topics_to_subscribe = []
    for t in config.get("topics", "").split(","):
        clean_t = t.strip()
        if not clean_t:
            continue
        base_topic = clean_t.split(":")[0]  # Schneidet ":weight_1" etc. ab
        if base_topic not in topics_to_subscribe:
            topics_to_subscribe.append(base_topic)

    while True:
        if not mqtt_connected:
            try:
                print("Verbinde mit MQTT Broker...", config["mqtt_server"])
                client = MQTTClient("esp32s3_matrix", config["mqtt_server"], port=int(config["mqtt_port"]))
                client.set_callback(mqtt_callback)
                
                # Wichtig: Erst connecten, dann wird der Socket erstellt!
                client.connect()
                
                # Alle ermittelten Basis-Topics abonnieren
                for topic in topics_to_subscribe:
                    print("Abonniere Topic:", topic)
                    client.subscribe(topic.encode('utf-8'))
                    
                mqtt_connected = True
                print("MQTT erfolgreich verbunden und Topics abonniert.")
            except Exception as e:
                print("MQTT Verbindungsfehler, neuer Versuch in 5s:", e)
                mqtt_connected = False
                await asyncio.sleep(5)
                continue

        # Wenn verbunden, eingehende Nachrichten prüfen
        try:
            client.check_msg()
        except Exception as e:
            print("Fehler im MQTT Loop (Verbindung verloren?):", e)
            mqtt_connected = False
            try:
                client.disconnect()
            except:
                pass
            
        await asyncio.sleep_ms(100)

async def main():
    asyncio.create_task(mqtt_loop())
    await scroll_text()

try:
    asyncio.run(main())
except KeyboardInterrupt:
    print("Skript gestoppt.")

